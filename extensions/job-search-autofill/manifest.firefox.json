{
  "manifest_version": 3,
  "name": "AI Job Search: 1-Click ATS Autofill",
  "version": "1.0.0",
  "description": "Zero-token, 1-click smart autofill for AshbyHQ, Greenhouse, Lever, Y Combinator, micro1, and Unstop.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.ashbyhq.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.workatastartup.com/*",
    "*://*.micro1.ai/*",
    "*://*.unstop.com/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Job Autofill"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-job-autofill@bored008.local",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ashbyhq.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.workatastartup.com/*",
        "*://*.micro1.ai/*",
        "*://*.unstop.com/*"
      ],
      "js": [
        "src/profile.js",
        "src/dom-engine.js",
        "src/matcher-rules.js",
        "src/bridge-client.js",
        "src/hud-view.js",
        "src/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
